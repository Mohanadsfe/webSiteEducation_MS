rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /** Teacher role in Firestore, or platform owner emails (soft admin) */
    function isOwnerEmail() {
      return signedIn() && (
        request.auth.token.email == 'safi89099@gmail.com'
        || request.auth.token.email == 'mohanadsfe@gmail.com'
      );
    }

    function isTeacher() {
      return signedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userData().role == 'teacher')
        || isOwnerEmail()
      );
    }

    function isEnrolled(courseId) {
      return signedIn() &&
        get(/databases/$(database)/documents/enrollments/$(request.auth.uid + "_" + courseId)).data.status == "active";
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if isTeacher() || (signedIn() && request.auth.uid == uid);
      allow delete: if isTeacher();
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      // Only platform owners may create/update/delete courses
      allow write: if isOwnerEmail();

      // Signed-in users can list lessons (UI: first video free; rest need personal course code).
      match /lessons/{lessonId} {
        allow read: if signedIn();
        allow write: if isOwnerEmail();
      }
    }

    match /enrollments/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.studentId == request.auth.uid);
      // Only owners grant / revoke access codes
      allow write: if isOwnerEmail();
    }

    match /teacher_approvals/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if isTeacher();
    }

    match /packages/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /site_settings/{id} {
      allow read: if true;
      allow write: if isTeacher() || isOwnerEmail();
    }

    match /purchases/{id} {
      allow read: if isTeacher()
        || (signedIn() && (
          resource.data.studentId == request.auth.uid
          || resource.data.studentEmail == request.auth.token.email
        ));
      allow write: if isTeacher();
    }

    match /appointments/{id} {
      allow read: if signedIn();
      // Student books self as confirmed immediately; owner/teacher may create any booking
      allow create: if isTeacher() || isOwnerEmail()
        || (signedIn()
            && request.resource.data.studentId == request.auth.uid
            && request.resource.data.status == 'confirmed');
      allow update: if isTeacher() || isOwnerEmail()
        // Student may update payment fields / reminders on own booking (cannot change status or identity)
        || (signedIn()
            && resource.data.studentId == request.auth.uid
            && request.resource.data.studentId == resource.data.studentId
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['paymentMethod', 'paymentStatus', 'updatedAt',
                          'reminderDayBeforeSent', 'reminderDayBeforeSentAt',
                          'reminderMorningSent', 'reminderMorningSentAt',
                          'reminderHours5Sent', 'reminderHours5SentAt']));
      // Only owner/teacher may delete active bookings (frees the hour on the schedule).
      // Signed-in users may purge past 90-day retention only.
      allow delete: if isTeacher()
        || isOwnerEmail()
        || (signedIn()
            && resource.data.expiresAt != null
            && request.time >= resource.data.expiresAt)
        || (signedIn()
            && resource.data.createdAt != null
            && request.time >= resource.data.createdAt + duration.value(90, 'd'));
    }

    match /opinions/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isTeacher() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // Student exams — students manage their own; teachers see all
    match /student_exams/{id} {
      allow read: if isTeacher()
        || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.examName is string
        && request.resource.data.examName.size() > 0;
      allow update: if isTeacher()
        || (signedIn()
            && resource.data.studentId == request.auth.uid
            && request.resource.data.studentId == request.auth.uid);
      allow delete: if isTeacher()
        || (signedIn() && resource.data.studentId == request.auth.uid);
    }
  }
}
